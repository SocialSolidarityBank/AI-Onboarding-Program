# Supabase project credentials
# 대시보드 → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://<your-project>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<your-anon-key>

# Magic Link 콜백이 돌아올 사이트 URL
# 로컬: http://localhost:3000
# 운영: https://<your-vercel-domain>
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Resend 트랜잭셔널 메일 (Phase H)
# resend.com 대시보드 → API Keys
# 미설정 시 신청 확인 메일 발송은 서버 콘솔 로그로만 처리됨 (graceful fallback)
RESEND_API_KEY=
# 발신자 이메일. ggbss.or.kr이 Google Workspace에 묶여 있어
# 충돌 회피용 서브도메인 mail.ggbss.or.kr 을 Resend 발송 전용으로 사용
EMAIL_FROM="사회연대은행 <noreply@mail.ggbss.or.kr>"
